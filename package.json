{
  "name": "vomit-vnext",
  "version": "1.18.4",
  "description": "A keyboard-centric markdown editor and presentation app with IntelliSense, live preview, and presenter view",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "postinstall": "node scripts/verify-electron.cjs",
    "build": "electron-builder --mac",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "make:icon": "electron scripts/make-icon.cjs && bash scripts/build-icons.sh"
  },
  "keywords": [
    "markdown",
    "editor",
    "presentation",
    "slides"
  ],
  "author": {
    "name": "Jacqueline",
    "email": "jacqueline@vomit.app"
  },
  "license": "MIT",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "electron": "41.7.1",
    "electron-builder": "^26.8.1",
    "semantic-release": "^25.0.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "diff": "^9.0.0",
    "electron-store": "11.0.2",
    "highlight.js": "^11.9.0",
    "marked": "18.0.5",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.0.227",
    "plantuml-encoder": "^1.4.0"
  },
  "build": {
    "appId": "com.vomit.vnext",
    "productName": "Vomit",
    "publish": null,
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "files": [
      "src/**/*",
      "bin/**/*",
      "node_modules/**/*",
      "manual.md"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown",
        "role": "Editor"
      },
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Viewer"
      },
      {
        "ext": "drawio",
        "name": "Draw.io Diagram",
        "role": "Viewer"
      },
      {
        "ext": "png",
        "name": "Image File",
        "role": "Viewer"
      },
      {
        "ext": "jpg",
        "name": "Image File",
        "role": "Viewer"
      },
      {
        "ext": "jpeg",
        "name": "Image File",
        "role": "Viewer"
      },
      {
        "ext": "gif",
        "name": "Image File",
        "role": "Viewer"
      },
      {
        "ext": "webp",
        "name": "Image File",
        "role": "Viewer"
      },
      {
        "ext": "svg",
        "name": "Image File",
        "role": "Viewer"
      },
      {
        "ext": "bmp",
        "name": "Image File",
        "role": "Viewer"
      },
      {
        "ext": "ico",
        "name": "Image File",
        "role": "Viewer"
      },
      {
        "ext": "avif",
        "name": "Image File",
        "role": "Viewer"
      }
    ]
  }
}
