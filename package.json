{
  "name": "vomit-vnext",
  "version": "1.6.11",
  "description": "A keyboard-centric markdown editor and presentation app with IntelliSense, live preview, and presenter view",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:mac": "electron-builder --mac",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "markdown",
    "editor",
    "presentation",
    "slides"
  ],
  "author": {
    "name": "Jacqueline",
    "email": "jacqueline@vomit.app"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "electron-store": "^8.2.0",
    "highlight.js": "^11.9.0",
    "marked": "^11.1.1",
    "node-pty": "^1.1.0",
    "plantuml-encoder": "^1.4.0"
  },
  "build": {
    "appId": "com.vomit.vnext",
    "productName": "Vomit",
    "publish": null,
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "files": [
      "src/**/*",
      "bin/**/*",
      "node_modules/**/*",
      "manual.md"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown",
        "role": "Editor"
      }
    ]
  }
}
